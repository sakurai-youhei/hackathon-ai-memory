ES_ENDPOINT=
KB_ENDPOINT=
ES_API_KEY=

GCP_PROJECT_ID=
GCP_REGION=

# Which embedding models to enable (space-separated: e5 bge_m3 qwen3).
# Default: e5 only. BGE-M3 and Qwen3 require TEI deployed on Cloud Run first.
AI_MEMORY_MODELS=e5

# Shared secret for TEI Cloud Run services (generate once: python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
TEI_API_KEY=

# Cloud Run URLs for TEI services (set after running: make deploy-tei)
BGE_M3_URL=
QWEN3_URL=

# Optional: override inference endpoint IDs (default to ai-memory-* aliases)
# Use EIS fallbacks if TEI is unavailable: .jina-embeddings-v3 / .jina-embeddings-v5-text-small
BGE_M3_INFERENCE_ID=
QWEN3_INFERENCE_ID=
