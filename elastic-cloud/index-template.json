{
  "index_patterns": [
    "*-ai-memory"
  ],
  "priority": 550,
  "version": 1,
  "composed_of": [
    "ai-memory@mappings",
    "ai-memory@semantic-e5",
    "ai-memory@semantic-jina-v3",
    "ai-memory@semantic-jina-v5s",
    "ai-memory@custom"
  ],
  "ignore_missing_component_templates": [
    "ai-memory@semantic-e5",
    "ai-memory@semantic-jina-v3",
    "ai-memory@semantic-jina-v5s",
    "ai-memory@custom"
  ],
  "allow_auto_create": true,
  "_meta": {
    "description": "Per-user AI memory indices named <uuid>-ai-memory. Plain indices: no data stream, no ILM (Elastic Cloud Serverless). Semantic component templates are optional; missing ones are silently skipped.",
    "project": "hackathon-ai-memory",
    "repository": "https://github.com/sakurai-youhei/hackathon-ai-memory",
    "managed_by": "hackathon-ai-memory"
  }
}
