{
  "template": {
    "settings": {
      "index": {
        "default_pipeline": "ai-memory",
        "mapping": {
          "total_fields": {
            "limit": 2000
          },
          "ignore_malformed": true
        },
        "query": {
          "default_field": [
            "title",
            "title.ja",
            "text",
            "text.ja",
            "summary",
            "summary.ja",
            "tags",
            "ocr.text"
          ]
        },
        "analysis": {
          "char_filter": {
            "ai_memory_nfkc_cf": {
              "type": "icu_normalizer",
              "name": "nfkc_cf",
              "mode": "compose"
            }
          },
          "tokenizer": {
            "ai_memory_kuromoji": {
              "type": "kuromoji_tokenizer",
              "mode": "search",
              "discard_compound_token": false
            }
          },
          "filter": {
            "ai_memory_ja_stop": {
              "type": "ja_stop",
              "stopwords": [
                "_japanese_"
              ]
            }
          },
          "analyzer": {
            "ai_memory_ja": {
              "type": "custom",
              "char_filter": [
                "kuromoji_iteration_mark",
                "ai_memory_nfkc_cf"
              ],
              "tokenizer": "ai_memory_kuromoji",
              "filter": [
                "kuromoji_baseform",
                "kuromoji_part_of_speech",
                "ai_memory_ja_stop",
                "kuromoji_number",
                "kuromoji_stemmer",
                "cjk_width",
                "lowercase"
              ]
            },
            "ai_memory_cjk_bigram": {
              "type": "custom",
              "char_filter": [
                "ai_memory_nfkc_cf"
              ],
              "tokenizer": "standard",
              "filter": [
                "cjk_width",
                "lowercase",
                "cjk_bigram"
              ]
            }
          },
          "normalizer": {
            "ai_memory_keyword": {
              "type": "custom",
              "char_filter": [
                "ai_memory_nfkc_cf"
              ],
              "filter": [
                "cjk_width",
                "lowercase",
                "trim"
              ]
            }
          }
        }
      }
    },
    "mappings": {
      "dynamic": "false",
      "_meta": {
        "schema_version": 1,
        "description": "ai-memory document schema (agent-uploaded text and Cloud Vision OCR photo documents)"
      },
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time_nanos||strict_date_optional_time||epoch_millis"
        },
        "created_at": {
          "type": "date",
          "format": "strict_date_optional_time_nanos||strict_date_optional_time||epoch_millis"
        },
        "updated_at": {
          "type": "date",
          "format": "strict_date_optional_time_nanos||strict_date_optional_time||epoch_millis"
        },
        "owner": {
          "type": "keyword"
        },
        "event": {
          "properties": {
            "kind": {
              "type": "keyword"
            }
          }
        },
        "title": {
          "type": "text",
          "copy_to": [
            "semantic_e5",
            "semantic_jina_v3",
            "semantic_jina_v5s"
          ],
          "fields": {
            "ja": {
              "type": "text",
              "analyzer": "ai_memory_ja"
            },
            "keyword": {
              "type": "keyword",
              "normalizer": "ai_memory_keyword",
              "ignore_above": 256
            }
          }
        },
        "text": {
          "type": "text",
          "copy_to": [
            "semantic_e5",
            "semantic_jina_v3",
            "semantic_jina_v5s"
          ],
          "fields": {
            "ja": {
              "type": "text",
              "analyzer": "ai_memory_ja"
            },
            "cjk": {
              "type": "text",
              "analyzer": "ai_memory_cjk_bigram"
            }
          }
        },
        "summary": {
          "type": "text",
          "fields": {
            "ja": {
              "type": "text",
              "analyzer": "ai_memory_ja"
            }
          }
        },
        "tags": {
          "type": "keyword",
          "normalizer": "ai_memory_keyword",
          "ignore_above": 128
        },
        "language": {
          "type": "keyword"
        },
        "source": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "app": {
              "type": "keyword"
            },
            "id": {
              "type": "keyword",
              "ignore_above": 512
            },
            "uri": {
              "type": "keyword",
              "ignore_above": 2048,
              "index": false
            }
          }
        },
        "attachment": {
          "properties": {
            "gcs_uri": {
              "type": "keyword",
              "ignore_above": 2048
            },
            "bucket": {
              "type": "keyword",
              "ignore_above": 256
            },
            "object_name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "download_url": {
              "type": "keyword",
              "ignore_above": 2048,
              "index": false
            },
            "content_type": {
              "type": "keyword",
              "ignore_above": 128
            },
            "size_bytes": {
              "type": "long"
            },
            "width": {
              "type": "integer"
            },
            "height": {
              "type": "integer"
            },
            "checksum_md5": {
              "type": "keyword",
              "ignore_above": 64,
              "index": false
            },
            "captured_at": {
              "type": "date",
              "format": "strict_date_optional_time_nanos||strict_date_optional_time||epoch_millis"
            }
          }
        },
        "ocr": {
          "properties": {
            "engine": {
              "type": "keyword",
              "ignore_above": 64
            },
            "language": {
              "type": "keyword",
              "ignore_above": 16
            },
            "confidence": {
              "type": "float"
            },
            "block_count": {
              "type": "integer"
            },
            "text": {
              "type": "text",
              "analyzer": "ai_memory_ja"
            }
          }
        },
        "stats": {
          "properties": {
            "char_count": {
              "type": "integer"
            }
          }
        },
        "error": {
          "properties": {
            "pipeline": {
              "type": "keyword",
              "ignore_above": 256
            },
            "processor_type": {
              "type": "keyword",
              "ignore_above": 128
            },
            "processor_tag": {
              "type": "keyword",
              "ignore_above": 128
            },
            "message": {
              "type": "text"
            }
          }
        },
        "metadata": {
          "type": "flattened",
          "ignore_above": 1024
        },
        "semantic_e5": {
          "type": "semantic_text",
          "inference_id": ".multilingual-e5-small-elasticsearch"
        },
        "semantic_jina_v3": {
          "type": "semantic_text",
          "inference_id": ".jina-embeddings-v3"
        },
        "semantic_jina_v5s": {
          "type": "semantic_text",
          "inference_id": ".jina-embeddings-v5-text-small"
        }
      }
    }
  },
  "version": 3,
  "_meta": {
    "description": "ai-memory index settings and document schema combined. Settings and mappings must share one component template so custom analyzers are in scope during mapping validation.",
    "managed_by": "hackathon-ai-memory"
  }
}
