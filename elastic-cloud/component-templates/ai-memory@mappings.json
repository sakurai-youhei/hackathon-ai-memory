{
  "template": {
    "mappings": {
      "dynamic": "false",
      "_meta": {
        "schema_version": 1,
        "description": "ai-memory document schema (agent-uploaded text and Cloud Vision OCR photo documents)"
      },
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time_nanos||strict_date_optional_time||epoch_millis"
        },
        "created_at": {
          "type": "date",
          "format": "strict_date_optional_time_nanos||strict_date_optional_time||epoch_millis"
        },
        "updated_at": {
          "type": "date",
          "format": "strict_date_optional_time_nanos||strict_date_optional_time||epoch_millis"
        },
        "owner": {
          "type": "keyword"
        },
        "event": {
          "properties": {
            "kind": {
              "type": "keyword"
            }
          }
        },
        "title": {
          "type": "text",
          "copy_to": [
            "semantic_e5",
            "semantic_jina_v3",
            "semantic_jina_v5s"
          ],
          "fields": {
            "ja": {
              "type": "text",
              "analyzer": "ai_memory_ja"
            },
            "keyword": {
              "type": "keyword",
              "normalizer": "ai_memory_keyword",
              "ignore_above": 256
            }
          }
        },
        "text": {
          "type": "text",
          "copy_to": [
            "semantic_e5",
            "semantic_jina_v3",
            "semantic_jina_v5s"
          ],
          "fields": {
            "ja": {
              "type": "text",
              "analyzer": "ai_memory_ja"
            },
            "cjk": {
              "type": "text",
              "analyzer": "ai_memory_cjk_bigram"
            }
          }
        },
        "summary": {
          "type": "text",
          "fields": {
            "ja": {
              "type": "text",
              "analyzer": "ai_memory_ja"
            }
          }
        },
        "tags": {
          "type": "keyword",
          "normalizer": "ai_memory_keyword",
          "ignore_above": 128
        },
        "language": {
          "type": "keyword"
        },
        "source": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "app": {
              "type": "keyword"
            },
            "id": {
              "type": "keyword",
              "ignore_above": 512
            },
            "uri": {
              "type": "keyword",
              "ignore_above": 2048,
              "index": false
            }
          }
        },
        "attachment": {
          "properties": {
            "gcs_uri": {
              "type": "keyword",
              "ignore_above": 2048
            },
            "bucket": {
              "type": "keyword",
              "ignore_above": 256
            },
            "object_name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "download_url": {
              "type": "keyword",
              "ignore_above": 2048,
              "index": false
            },
            "content_type": {
              "type": "keyword",
              "ignore_above": 128
            },
            "size_bytes": {
              "type": "long"
            },
            "width": {
              "type": "integer"
            },
            "height": {
              "type": "integer"
            },
            "checksum_md5": {
              "type": "keyword",
              "ignore_above": 64,
              "index": false
            },
            "captured_at": {
              "type": "date",
              "format": "strict_date_optional_time_nanos||strict_date_optional_time||epoch_millis"
            }
          }
        },
        "ocr": {
          "properties": {
            "engine": {
              "type": "keyword",
              "ignore_above": 64
            },
            "language": {
              "type": "keyword",
              "ignore_above": 16
            },
            "confidence": {
              "type": "float"
            },
            "block_count": {
              "type": "integer"
            },
            "text": {
              "type": "text",
              "analyzer": "ai_memory_ja"
            }
          }
        },
        "stats": {
          "properties": {
            "char_count": {
              "type": "integer"
            }
          }
        },
        "error": {
          "properties": {
            "pipeline": {
              "type": "keyword",
              "ignore_above": 256
            },
            "processor_type": {
              "type": "keyword",
              "ignore_above": 128
            },
            "processor_tag": {
              "type": "keyword",
              "ignore_above": 128
            },
            "message": {
              "type": "text"
            }
          }
        },
        "metadata": {
          "type": "flattened",
          "ignore_above": 1024
        },
        "semantic_e5": {
          "type": "semantic_text",
          "inference_id": "ai-memory-e5"
        },
        "semantic_jina_v3": {
          "type": "semantic_text",
          "inference_id": ".jina-embeddings-v3"
        },
        "semantic_jina_v5s": {
          "type": "semantic_text",
          "inference_id": ".jina-embeddings-v5-text-small"
        }
      }
    }
  },
  "version": 2,
  "_meta": {
    "description": "Core ai-memory document schema. Semantic fields are defined here (for copy_to resolution) and augmented with chunking_settings by ai-memory@semantic-* component templates.",
    "managed_by": "hackathon-ai-memory"
  }
}
