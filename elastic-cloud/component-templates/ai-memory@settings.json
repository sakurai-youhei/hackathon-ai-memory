{
  "template": {
    "settings": {
      "index": {
        "default_pipeline": "ai-memory",
        "mapping": {
          "total_fields": {
            "limit": 2000
          },
          "ignore_malformed": true
        },
        "query": {
          "default_field": [
            "title",
            "title.ja",
            "text",
            "text.ja",
            "summary",
            "summary.ja",
            "tags",
            "ocr.text"
          ]
        },
        "analysis": {
          "char_filter": {
            "ai_memory_nfkc_cf": {
              "type": "icu_normalizer",
              "name": "nfkc_cf",
              "mode": "compose"
            }
          },
          "tokenizer": {
            "ai_memory_kuromoji": {
              "type": "kuromoji_tokenizer",
              "mode": "search",
              "discard_compound_token": false
            }
          },
          "filter": {
            "ai_memory_ja_stop": {
              "type": "ja_stop",
              "stopwords": [
                "_japanese_"
              ]
            }
          },
          "analyzer": {
            "ai_memory_ja": {
              "type": "custom",
              "char_filter": [
                "kuromoji_iteration_mark",
                "ai_memory_nfkc_cf"
              ],
              "tokenizer": "ai_memory_kuromoji",
              "filter": [
                "kuromoji_baseform",
                "kuromoji_part_of_speech",
                "ai_memory_ja_stop",
                "kuromoji_number",
                "kuromoji_stemmer",
                "cjk_width",
                "lowercase"
              ]
            },
            "ai_memory_cjk_bigram": {
              "type": "custom",
              "char_filter": [
                "ai_memory_nfkc_cf"
              ],
              "tokenizer": "standard",
              "filter": [
                "cjk_width",
                "lowercase",
                "cjk_bigram"
              ]
            }
          },
          "normalizer": {
            "ai_memory_keyword": {
              "type": "custom",
              "char_filter": [
                "ai_memory_nfkc_cf"
              ],
              "filter": [
                "cjk_width",
                "lowercase",
                "trim"
              ]
            }
          }
        }
      }
    }
  },
  "version": 1,
  "_meta": {
    "description": "Index settings for per-user ai-memory indices: default ingest pipeline and Japanese/CJK analysis chain.",
    "managed_by": "hackathon-ai-memory"
  }
}
