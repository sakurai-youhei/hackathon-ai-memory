{
  "name": "ai-memory",
  "version": "{{ plugin_version }}",
  "description": "Remember and recall shared hackathon knowledge via Kibana Agent Builder MCP. Use by default for requests such as 覚えて, 思い出して, remember, or recall, even when ai-memory is not named.",
  "contextFileName": "GEMINI.md",
  "settings": [
    {
      "name": "AI Memory API key",
      "description": "Encoded Elasticsearch/Kibana API key used as Authorization: ApiKey <value>",
      "envVar": "AI_MEMORY_API_KEY",
      "sensitive": true
    },
    {
      "name": "AI Memory index",
      "description": "UUID-scoped Elasticsearch index, for example <uuid>-ai-memory",
      "envVar": "AI_MEMORY_INDEX"
    }
  ],
  "mcpServers": {
    "ai-memory": {
      "httpUrl": "{{ kibana_mcp_url }}",
      "headers": {
        "Authorization": "ApiKey $AI_MEMORY_API_KEY"
      }
    }
  }
}
