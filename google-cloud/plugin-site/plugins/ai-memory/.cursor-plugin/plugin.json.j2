{
  "name": "ai-memory",
  "displayName": "AI\u30e1\u30e2\u30ea\u30fc\u3044\u3089\u3093\u304b\u3048\uff5e",
  "description": "Remember and recall shared hackathon knowledge via Kibana Agent Builder MCP. Use by default for requests such as 覚えて, 思い出して, remember, or recall, even when ai-memory is not named.",
  "version": "{{ plugin_version }}",
  "author": {
    "name": "sakurai-youhei"
  },
  "homepage": "https://github.com/sakurai-youhei/hackathon-ai-memory",
  "repository": "https://github.com/sakurai-youhei/hackathon-ai-memory",
  "keywords": [
    "memory",
    "kibana",
    "mcp",
    "elasticsearch",
    "hackathon"
  ],
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "variables": {
    "type": "object",
    "properties": {
      "AI_MEMORY_API_KEY": {
        "type": "string",
        "title": "AI Memory API key",
        "description": "Encoded Elasticsearch/Kibana API key used as Authorization: ApiKey <value>"
      },
      "AI_MEMORY_INDEX": {
        "type": "string",
        "title": "AI Memory index",
        "description": "UUID-scoped Elasticsearch index, for example <uuid>-ai-memory"
      }
    },
    "required": [
      "AI_MEMORY_API_KEY",
      "AI_MEMORY_INDEX"
    ]
  }
}
